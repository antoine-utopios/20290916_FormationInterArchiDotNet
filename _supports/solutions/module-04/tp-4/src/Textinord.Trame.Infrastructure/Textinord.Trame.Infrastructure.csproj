<Project Sdk="Microsoft.NET.Sdk">
  <!-- Persistance de Trame 2 : EF Core 10 (SQLite en local, SQL Server / Azure SQL en cible) + Dapper en lecture. -->
  <PropertyGroup>
    <RootNamespace>Textinord.Trame.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Textinord.Trame.Domain/Textinord.Trame.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Cible de production : décommenter et retirer le provider SQLite si nécessaire.
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
