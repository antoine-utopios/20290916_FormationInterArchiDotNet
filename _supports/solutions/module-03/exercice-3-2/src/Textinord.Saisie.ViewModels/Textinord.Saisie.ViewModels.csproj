<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bibliothèque de ViewModels multiplateforme : aucune référence à WinForms ou WPF,
       elle compile et se teste sur Windows, macOS et Linux. La vue Windows la référence. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Textinord.Saisie.ViewModels</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
