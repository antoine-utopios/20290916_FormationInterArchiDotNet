@page "/confirmation/{Numero}"
@inject ICommandeService Commandes

<PageTitle>Commande @Numero - Textinord</PageTitle>

@if (commande is null)
{
    <h1>Commande introuvable</h1>
    <p class="text-muted">Aucune commande ne porte le numéro <code>@Numero</code>.</p>
}
else
{
    <h1>Commande @commande.Numero enregistrée</h1>

    @if (commande.Statut == StatutCommande.EnAttenteStock)
    {
        <div class="alert alert-warning" role="alert">
            Une ou plusieurs lignes n'ont pas de stock suffisant dans un entrepôt : la commande est
            <strong>en attente de stock</strong>. L'ADV vous contactera sous 24 h.
        </div>
    }
    else
    {
        <div class="alert alert-success" role="status">
            Commande <strong>validée</strong> : les ordres de préparation sont émis vers Roubaix et Lesquin.
        </div>
    }

    <dl class="row">
        <dt class="col-sm-4">Votre référence</dt>
        <dd class="col-sm-8">@commande.ReferenceClient</dd>
        <dt class="col-sm-4">Livraison souhaitée</dt>
        <dd class="col-sm-8">@Format.Date(commande.DateLivraisonSouhaitee)</dd>
        <dt class="col-sm-4">Total net HT</dt>
        <dd class="col-sm-8">@Format.Prix(commande.TotalNet)</dd>
    </dl>

    <table class="table">
        <thead>
            <tr><th>Référence</th><th>Article</th><th class="text-end">Quantité</th><th class="text-end">Remise</th><th class="text-end">Net HT</th></tr>
        </thead>
        <tbody>
            @foreach (var ligne in commande.Lignes)
            {
                <tr>
                    <td><code>@ligne.Reference</code></td>
                    <td>@ligne.Libelle</td>
                    <td class="text-end">@ligne.Quantite</td>
                    <td class="text-end">@Format.Pourcent(ligne.TauxRemise)</td>
                    <td class="text-end">@Format.Prix(ligne.MontantNet)</td>
                </tr>
            }
        </tbody>
    </table>

    <a class="btn btn-outline-primary" href="catalogue">Retour au catalogue</a>
}

@code {
    private Commande? commande;

    [Parameter]
    public string Numero { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        commande = await Commandes.TrouverAsync(Numero);
    }
}
